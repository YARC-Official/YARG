<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <YargAudioNativeConfiguration Condition="'$(YargAudioNativeConfiguration)' == ''">Release</YargAudioNativeConfiguration>
    <YargAudioPlatform Condition="'$(YargAudioPlatform)' == '' and '$(OS)' == 'Windows_NT'">Windows</YargAudioPlatform>
    <YargAudioLibraryPath Condition="'$(YargAudioLibraryPath)' == '' and '$(YargAudioPlatform)' == 'Windows'">../../build/windows-x64/$(YargAudioNativeConfiguration)/yarg_audio.dll</YargAudioLibraryPath>
    <YargAudioLibraryPath Condition="'$(YargAudioLibraryPath)' == '' and '$(YargAudioPlatform)' == 'Linux'">../../build/linux-x64/libyarg_audio.so</YargAudioLibraryPath>
    <YargAudioLibraryPath Condition="'$(YargAudioLibraryPath)' == '' and '$(YargAudioPlatform)' == 'MacOS'">../../build/macos-universal/libyarg_audio.dylib</YargAudioLibraryPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(YargAudioPlatform)' == 'Windows'">
    <NativeDependency Include="../../../../Assets/Plugins/BassNative/Windows/x86_64/bass.dll" />
    <NativeDependency Include="../../../../Assets/Plugins/BassNative/Windows/x86_64/bassmix.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(YargAudioPlatform)' == 'Linux'">
    <NativeDependency Include="../../../../Assets/Plugins/BassNative/Linux/x86_64/libbass.so" />
    <NativeDependency Include="../../../../Assets/Plugins/BassNative/Linux/x86_64/libbassmix.so" />
  </ItemGroup>
  <ItemGroup Condition="'$(YargAudioPlatform)' == 'MacOS'">
    <NativeDependency Include="../../../../Assets/Plugins/BassNative/Mac/libbass.dylib" />
    <NativeDependency Include="../../../../Assets/Plugins/BassNative/Mac/libbassmix.dylib" />
  </ItemGroup>
  <ItemGroup>
    <NativeDependency Include="$(YargAudioLibraryPath)" />
  </ItemGroup>

  <Target Name="CopyNativeDependencies" AfterTargets="Build">
    <Error Condition="'@(NativeDependency)' == ''"
      Text="Set YargAudioPlatform to Windows, Linux, or MacOS." />
    <Copy SourceFiles="@(NativeDependency)" DestinationFolder="$(OutputPath)" />
  </Target>
</Project>
